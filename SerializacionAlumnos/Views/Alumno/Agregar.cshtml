@model SerializacionAlumnos.Models.Alumno

@{
    ViewBag.Title = "Agregar Alumno";
}

<h2>Agregar Alumno</h2>

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>DNI</label>
        @Html.TextBoxFor(m => m.Dni,
          new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Nombres</label>
        @Html.TextBoxFor(m => m.Nombres,
          new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Apellidos</label>
        @Html.TextBoxFor(m => m.Apellidos,
          new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Carrera</label>
        @Html.TextBoxFor(m => m.Carrera,
          new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Ciclo</label>
        @Html.TextBoxFor(m => m.Ciclo,
          new { @class = "form-control" })
    </div>

    <br />

    <input type="submit"
           value="Guardar"
           class="btn btn-success" />

    @Html.ActionLink("Regresar",
                     "Index",
                     null,
                     new { @class = "btn btn-primary" })
}